# --- Telegram (Telethon) ---
# Obtain from https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# Filled in after running `wb-watch tg-login` (StringSession). Keep secret.
TG_SESSION=

# --- Wildberries tunables (defaults are sane; override only if needed) ---
# Delivery destination code used in card/search queries (-1257786 = Moscow region).
WB_DEST=-1257786
# Min seconds between WB HTTP requests (global throttle).
WB_MIN_INTERVAL=0.6
# Max retry attempts on 429 / 5xx.
WB_MAX_RETRIES=6

# --- Paths (optional overrides) ---
WB_DB_PATH=data/wb_watch.db
WB_EXPORT_DIR=exports
