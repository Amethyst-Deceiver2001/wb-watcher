233, 9715, 3493, 17519, 8068, 7425, 3266, 3234, 1504, 15103, 7551, 13088, 11, 51859], "temperature": 0, "avg_logprob": -0.11600977141281654, "compression_ratio": 2.1191709844559585, "no_speech_prob": 0.003376042004674673}, {"id": 34, "seek": 14508, "start": 145.08, "end": 148.48000000000002, "text": " который в последнее время был в состоянии возникнуть в течение всего года.", "tokens": [50365, 11897, 740, 19253, 15627, 12039, 10059, 740, 36017, 435, 8918, 9715, 23431, 740, 1069, 44274, 15520, 18411, 13, 50535], "temperature": 0, "avg_logprob": -0.3166680478764151, "compression_ratio": 2.1138392857142856, "no_speech_prob": 0.007813267409801483}, {"id": 35, "seek": 14508, "start": 148.48000000000002, "end": 152.48000000000002, "text": " Это позволило и позволяет нам обеспечить безопасность людей на складах,", "tokens": [50535, 6684, 28805, 22201, 1006, 28805, 27516, 11401, 3348, 21186, 4310, 3258, 45015, 9930, 16810, 1470, 46185, 7004, 11, 50735], "temperature": 0, "avg_logprob": -0.3166680478764151, "compression_ratio": 2.1138392857142856, "no_speech_prob": 0.007813267409801483}, {"id": 36, "seek": 14508, "start": 152.48000000000002, "end": 158.48000000000002, "text": " оперативно локализовывать возгорания и по возможности сохранять в целостности товары наших продавцов.", "tokens": [50735, 36742, 30875, 1234, 2344, 2637, 28105, 1055, 25265, 8918, 45628, 8831, 1006, 2801, 26740, 4756, 41571, 8773, 740, 22750, 16543, 13975, 35838, 48632, 41525, 11354, 1828, 1814, 1055, 13, 51035], "temperature": 0, "avg_logprob": -0.3166680478764151, "compression_ratio": 2.1138392857142856, "no_speech_prob": 0.007813267409801483}, {"id": 37, "seek": 14508, "start": 158.48000000000002, "end": 162.48000000000002, "text": " При этом надо понимать, что БПЛА, которые бьют по промышленным объектам,", "tokens": [51035, 22059, 10755, 13256, 15084, 2209, 11, 2143, 5697, 9223, 14854, 5594, 11, 10381, 1268, 38934, 2801, 42988, 12533, 11586, 8412, 16646, 9822, 1685, 11, 51235], "temperature": 0, 