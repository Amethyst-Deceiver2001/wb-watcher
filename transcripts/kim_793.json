анша поддерживающих выплат продавцам,", "tokens": [50565, 38401, 48123, 24051, 42304, 4655, 6970, 11, 4777, 13422, 8334, 7520, 18505, 45454, 47247, 30756, 2739, 18718, 4165, 21188, 25834, 11354, 1828, 1814, 1685, 11, 50865], "temperature": 0, "avg_logprob": -0.059855111440022785, "compression_ratio": 1.9635922330097086, "no_speech_prob": 0.03618507459759712}, {"id": 58, "seek": 23348, "start": 243.48, "end": 245.48, "text": " чьи товары пострадали в результате атак.", "tokens": [50865, 1358, 678, 435, 35838, 48632, 2801, 5530, 2601, 4071, 740, 28476, 387, 2559, 13721, 13, 50965], "temperature": 0, "avg_logprob": -0.059855111440022785, "compression_ratio": 1.9635922330097086, "no_speech_prob": 0.03618507459759712}, {"id": 59, "seek": 23348, "start": 245.48, "end": 251.48, "text": " Во вторую волну попало почти 100 тысяч представителей малого и среднего бизнеса,", "tokens": [50965, 24334, 19823, 3924, 22211, 7537, 10694, 12441, 30529, 2319, 25025, 27167, 29952, 19499, 2350, 1006, 20446, 33727, 47054, 386, 11, 51265], "temperature": 0, "avg_logprob": -0.059855111440022785, "compression_ratio": 1.9635922330097086, "no_speech_prob": 0.03618507459759712}, {"id": 60, "seek": 23348, "start": 251.48, "end": 254.48, "text": " многие из которых уже получили начисления.", "tokens": [51265, 37343, 3943, 28700, 7520, 9478, 5435, 8970, 3323, 17881, 13, 51415], "temperature": 0, "avg_logprob": -0.059855111440022785, "compression_ratio": 1.9635922330097086, "no_speech_prob": 0.03618507459759712}, {"id": 61, "seek": 23348, "start": 254.48, "end": 260.48, "text": " Для наших более крупных партнеров мы ввели повышенную скидку постоянного покупателя на их товар за наш счет,", "tokens": [51415, 21324, 41525, 15103, 39207, 5783, 11813, 403, 489, 33985, 4777, 740, 859, 8334, 10499, 12533, 1008, 9882, 776, 2241, 856, 4401, 33212, 4699, 34005, 41330, 1470, 9642, 35838, 2222, 4396, 8253, 23812, 1094, 11, 51715], "temperature": 0, "avg_logprob": -0.059855111440022785, "compression_ratio": 1.9635922330097086, "no_speech_prob": 0.03618507459759712}, {"id": 62, "seek": 23348, "start": 260.48, "end": 262.48, "text": " кредитные каникулы в нашем банке,", "tokens": [51715, 7502, 2229, 1635, 4970, 18276, 3605, 23412, 698, 740, 48181, 29049, 8222, 11, 51815], "temperature": 0, "avg_logprob": -0.059855111440022785, "compression_ratio": 1.9635922330097086, "no_speech_prob": 0.03618507459759712}, {"id": 63, "seek": 26248, "start": 262.48, "end": 264.48, "text": " и ряд иных мер поддержки.", "tokens": [50365, 1006, 32921, 1006, 5783, 48231, 30756, 2241, 13, 50465], "temperature": 0, "avg_logprob": -0.03584359465418635, "compression_ratio": 2.0984848484848486, "no_speech_prob": 0.01566002517938614}, {"id": 64, "seek": 26248, "start": 264.48, "end": 271.48, "text": " Со следующей недели мы планируем проводить очные встречи с предпринимателями в наиболее пострадавших регионах,", "tokens": [50465, 40156, 26045, 2345, 15704, 8334, 4777, 9283, 3733, 2711, 1504, 33924, 3258, 5875, 4970, 25669, 435, 776, 8048, 48462, 8444, 41330, 6293, 740, 1470, 9772, 1227, 7752, 2801, 5530, 2601, 1828, 29024, 31235, 26875, 7004, 11, 50815], "temperature": 0, "avg_logprob": -0.03584359465418635, "compression_ratio": 2.0984848484848486, "no_speech_prob": 0.01566002517938614}, {"id": 65, "seek": 26248, "start": 271.48, "end": 276.48, "text": " чтобы точечно решать их актуальные проблемы, появившиеся на фоне ситуации.", "tokens": [50815, 7887, 23045, 11693, 14025, 2209, 9642, 13790, 13549, 25967, 44340, 11, 20011, 2739, 35202, 1679, 1470, 4394, 25561, 27840, 16715, 13, 51065], "temperature": 0, "avg_logprob": -0.03584359465418635, "compression_ratio": 2.0984848484848486, "no_speech_prob": 0.01566002517938614}, {"id": 66, "seek": 26248, "start": 276.48, "end": 283.48, "text": " Я уже говорила, что мы сейчас максимально оперативно перестраиваем свою логистическую инфраструктуру,", "tokens": [51065, 4857, 7520, 8180, 10578, 11, 2143, 4777, 10241, 35564, 10986, 36742, 30875, 1234, 4321, 5740, 3580, 33395, 23069, 2344, 2353, 9330, 9347, 35119, 6635, 3619, 3580, 36526, 13549, 2711, 11, 51415], "temperature": 0, "avg_logprob": -0.03584359465418635, "compression_ratio": 2.0984848484848486, "no_speech_prob": 0.01566002517938614}, {"id": 67, "seek": 26248, "start": 283.48, "end": 287.48, "text": " распределяем потоки по различным логистическим объектам,", "tokens": [51415, 26588, 10278, 15292, 1504, 6364, 48110, 2801, 40140, 8412, 2344, 2353, 9330, 9347, 30884, 16646, 9822, 1685, 11, 51615], "temperature": 0, "avg_logprob": -0.03584359465418635, "compression_ratio": 2.0984848484848486, "no_speech_prob": 0.01566002517938614}, {"id": 68, "seek": 26248, "start": 287.48, "end": 291.48, "text": " чтобы сохранить скорость доставки и оборачиваемость товаров наших партнеров.", "tokens": [51615, 7887, 41571, 3258, 17575, 25437, 5865, 6938, 2241, 1006, 3348, 1717, 8314, 33395, 25437, 35838, 48708, 41525, 11813, 403, 489, 33985, 13, 51815], "temperature": 0, "avg_logprob": -0.03584359465418635, "compression_ratio": 2.0984848484848486, "no_speech_prob": 0.01566002517938614}, {"id": 69, "seek": 29248, "start": 292.48, "end": 298.48, "text": " В целях безопасности детали раскрыть не могу, но будьте уверены, мы делаем все возможное для этого.", "tokens": [50365, 2348, 5188, 15292, 1157, 45015, 13975, 15079, 4071, 46666, 10461, 1283, 1725, 22951, 11, 6035, 4529, 30802, 32838, 16148, 11, 4777, 6649, 7906, 4640, 31544, 6126, 5561, 10751, 13, 50665], "temperature": 0, "avg_logprob": -0.05674302400048099, "compression_ratio": 1.9797468354430379, "no_speech_prob": 0.0014102488057687879}, {"id": 70, "seek": 29248, "start": 298.48, "end": 303.48, "text": " Никогда вас не подводили и всегда находили решение любой проблемы,", "tokens": [50665, 28448, 5590, 10655, 1725, 4095, 17533, 5435, 1006, 19087, 19363, 5435, 14025, 5627, 42803, 44340, 11, 50915], "temperature": 0, "avg_logprob": -0.05674302400048099, "compression_ratio": 1.9797468354430379, "no_speech_prob": 0.0014102488057687879}, {"id": 71, "seek": 29248, "start": 303.48, "end": 308.48, "text": " и я не вижу причин, почему текущая ситуация должна стать исключением.", "tokens": [50915, 1006, 2552, 1725, 47813, 26472, 2599, 11, 21513, 1069, 2872, 17263, 4251, 27840, 21235, 40129, 36415, 20284, 11833, 21297, 13, 51165], "temperature": 0, "avg_logprob": -0.05674302400048099, "compression_ratio": 1.9797468354430379, "no_speech_prob": 0.0014102488057687879}, {"id": 72, "seek": 29248, "start": 308.48, "end": 315.48, "text": " У нас десятки предложений по аренде логистических мощностей на территории России и за ее пределами.", "tokens": [51165, 6523, 6519, 45884, 2241, 40373, 17271, 2801, 16643, 1008, 6790, 2344, 2353, 9330, 38911, 39218, 34383, 2345, 1470, 49634, 47772, 29007, 1006, 4396, 14803, 8048, 1414, 5150, 13, 51515], "temperature": 0, "avg_logprob": -0.05674302400048099, "compression_ratio": 1.9797468354430379, "no_speech_prob": 0.0014102488057687879}, {"id": 73, "seek": 29248, "start": 315.48, "end": 318.48, "text": " Часть договоров уже заключена.", "tokens": [51515, 7099, 31789, 36056, 6362, 1055, 7520, 49613, 13362, 13, 51665], "temperature": 0, "avg_logprob": -0.05674302400048099, "compression_ratio": 1.9797468354430379, "no_speech_prob": 0.0014102488057687879}, {"id": 74, "seek": 29248, "start": 318.48, "end": 322.48, "text": " Помимо этого, скоро мы запустим в эксплуатацию наши объекты,", "tokens": [51665, 43030, 14365, 10751, 11, 44971, 4777, 10333, 15028, 2165, 740, 29030, 39852, 2134, 28254, 36314, 16646, 9822, 698, 11, 51865], "temperature": 0, "avg_logprob": -0.05674302400048099, "compression_ratio": 1.9797468354430379, "no_speech_prob": 0.0014102488057687879}, {"id": 75, "seek": 32248, "start": 322.48, "end": 325.48, "text": " которые строили в других странах нашего присутствия.", "tokens": [50365, 10381, 35860, 5435, 740, 31211, 18057, 7004, 45309, 26686, 47565, 7409, 13, 50515], "temperature": 0, "avg_logprob": -0.05937398446572793, "compression_ratio": 1.9924433249370277, "no_speech_prob": 0.06553228199481964}, {"id": 76, "seek": 32248, "start": 325.48, "end": 331.48, "text": " Совершая удары по нам, террористы прикрывают истинные причины и обвиняют нас в том,", "tokens": [50515, 45680, 19465, 4251, 39047, 698, 2801, 11401, 11, 21168, 481, 1717, 9330, 698, 25492, 17702, 6406, 1006, 982, 2599, 4970, 26472, 18835, 1006, 3348, 36823, 48891, 6519, 740, 13294, 11, 50815], "temperature": 0, "avg_logprob": -0.05937398446572793, "compression_ratio": 1.9924433249370277, "no_speech_prob": 0.06553228199481964}, {"id": 77, "seek": 32248, "start": 331.48, "end": 334.48, "text": " что мы якобы продаем товары военного назначения.", "tokens": [50815, 2143, 4777, 14760, 6379, 11354, 7906, 35838, 48632, 7900, 44620, 15006, 14272, 5332, 13, 50965], "temperature": 0, "avg_logprob": -0.05937398446572793, "compression_ratio": 1.9924433249370277, "no_speech_prob": 0.06553228199481964}, {"id": 78, "seek": 32248, "start": 334.48, "end": 342.48, "text": " Но вы можете открыть любой мировой маркетплейс Amazon или Alibaba и посмотреть, есть ли у нас то, чего нет у них.", "tokens": [50965, 7264, 2840, 23578, 27085, 1283, 42803, 1084, 10214, 1700, 31609, 755, 1094, 1354, 24698, 461, 6795, 8101, 967, 897, 5509, 1006, 38482, 11, 5640, 7444, 1595, 6519, 4572, 11, 19275, 9916, 1595, 14319, 13, 51365], "temperature": 0, "avg_logprob": -0.05937398446572793, "compression_ratio": 1.9924433249370277, "no_speech_prob": 0.06553228199481964}, {"id": 79, "seek": 32248, "start": 342.48, "end": 348.48, "text": " Никакой логики и здравого смысла, рациональности в действиях террористов нет и не может быть.", "tokens": [51365, 28448, 1272, 1700, 2344, 2353, 15562, 1006, 7608, 5608, 2350, 44045, 4989, 11, 1475, 44379, 10986, 4756, 740, 17136, 32176, 21168, 481, 1717, 9330, 1055, 9916, 1006, 1725, 8689, 11510, 13, 51665], "temperature": 0, "avg_logprob": -0.05937398446572793, "compression_ratio": 1.9924433249370277, "no_speech_prob": 0.06553228199481964}, {"id": 80, "seek": 32248, "start": 348.48, "end": 351.48, "text": " Противник сам сделал публичное заявление о том,", "tokens": [51665, 8567, 37324, 9715, 5602, 40653, 713, 8893, 15362, 6126, 38158, 17943, 1000, 13294, 11, 51815], "temperature": 0, "avg_logprob": -0.05937398446572793, "compression_ratio": 1.9924433249370277, "no_speech_prob": 0.06553228199481964}, {"id": 81, "seek": 35248, "start": 352.48, "end": 355.48, "text": " что атаки на Wildberries направлены на обычных граждан.", "tokens": [50365, 2143, 2559, 27430, 1470, 10904, 15290, 36437, 11586, 698, 1470, 32291, 5783, 11726, 11413, 1416, 13, 50515], "temperature": 0, "avg_logprob": -0.07057331737719084, "compression_ratio": 2.0526315789473686, "no_speech_prob": 0.005178912542760372}, {"id": 82, "seek": 35248, "start": 355.48, "end": 363.48, "text": " Единственная их цель – оказать давление, дестабилизировать, вызвать панику и шок у большого количества людей.", "tokens": [50515, 6538, 856, 2599, 12134, 6323, 9642, 5188, 3908, 1662, 28833, 2209, 12472, 17943, 11, 1070, 5740, 3771, 5435, 1544, 26411, 11, 31572, 859, 2209, 713, 1416, 35353, 1006, 5941, 2637, 1595, 12457, 2350, 25816, 12115, 16810, 13, 50915], "temperature": 0, "avg_logprob": -0.07057331737719084, "compression_ratio": 2.0526315789473686, "no_speech_prob": 0.005178912542760372}, {"id": 83, "seek": 35248, "start": 363.48, "end": 370.48, "text": " Единственное, что можно сейчас сделать, это с холодной головой всем нам, предпринимательскому сообществу России,", "tokens": [50915, 6538, 856, 2599, 12134, 6126, 11, 2143, 8885, 10241, 18695, 11, 2691, 776, 39726, 5007, 24721, 1700, 21042, 11401, 11, 8048, 48462, 8444, 10272, 4218, 4161, 7425, 12605, 42104, 29007, 11, 51265], "temperature": 0, "avg_logprob": -0.07057331737719084, "compression_ratio": 2.0526315789473686, "no_speech_prob": 0.005178912542760372}, {"id": 84, "seek": 35248, "start": 370.48, "end": 375.48, "text": " иметь план пересборки на ближайшее время, адаптироваться и трансформироваться.", "tokens": [51265, 7604, 9108, 23443, 4321, 2292, 1552, 1717, 2241, 1470, 21747, 1820, 3183, 46384, 12039, 11, 27705, 4219, 34996, 8525, 1006, 7550, 15720, 18190, 10214, 8525, 13, 51515], "temperature": 0, "avg_logprob": -0.07057331737719084, "compression_ratio": 2.0526315789473686, "no_speech_prob": 0.005178912542760372}, {"id": 85, "seek": 35248, "start": 375.48, "end": 379.48, "text": " Мы, предприниматели, умеем это делать, как никто другой.", "tokens": [51515, 12726, 11, 8048, 48462, 8444, 43512, 11, 17497, 387, 1504, 2691, 19284, 11, 3014, 31666, 27823, 13, 51715], "temperature": 0, "avg_logprob": -0.07057331737719084, "compression_ratio": 2.0526315789473686, "no_speech_prob": 0.005178912542760372}, {"id": 86, "seek": 35248, "start": 379.48, "end": 381.48, "text": " Мы видим, что ситуация сплотила всех.", "tokens": [51715, 12726, 38273, 11, 2143, 27840, 21235, 5307, 693, 1631, 10578, 17260, 13, 51815], "temperature": 0, "avg_logprob": -0.07057331737719084, "compression_ratio": 2.0526315789473686, "no_speech_prob": 0.005178912542760372}, {"id": 87, "seek": 38248, "start": 382.48, "end": 390.48, "text": " И предприниматели, и покупатели, и бизнес-сообщества, и представители региональных властей объединяются, чтобы вместе решить проблему.", "tokens": [50365, 3272, 8048, 48462, 8444, 43512, 11, 1006, 34005, 43512, 11, 1006, 47054, 12, 461, 354, 12605, 12115, 11, 1006, 27167, 29084, 31235, 26875, 30834, 740, 32465, 2345, 16646, 30741, 681, 21816, 11, 7887, 26905, 14025, 3258, 15122, 693, 8339, 13, 50765], "temperature": 0, "avg_logprob": -0.057954247464838717, "compression_ratio": 1.8114478114478114, "no_speech_prob": 0.000954692077357322}, {"id": 88, "seek": 38248, "start": 390.48, "end": 395.48, "text": " Мы сделаем все, чтобы помочь бизнесу справиться с этой непростой ситуацией.", "tokens": [50765, 12726, 10326, 7906, 4640, 11, 7887, 8613, 27497, 47054, 585, 31853, 12306, 776, 14907, 17005, 46155, 1700, 27840, 8392, 2345, 13, 51015], "temperature": 0, "avg_logprob": -0.057954247464838